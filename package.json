{
  "name": "shapeos",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@shapeos/web",
    "dev:mobile": "turbo run dev --filter=@shapeos/mobile",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test:shared": "tsx scripts/test-shared.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "gen:types": "supabase gen types typescript --local > packages/shared/src/types/database.generated.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "playwright": "^1.62.1",
    "supabase": "^2.9.6",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
